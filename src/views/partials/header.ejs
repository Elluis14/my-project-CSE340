
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <link
    rel="stylesheet"
    href="/css/styles.css"
  >
</head>

<body>

  <header class="site-header">

    <div class="header-container">

      <a href="/" class="site-logo">
        Community Connect
      </a>

      <nav aria-label="Main navigation">

        <ul class="nav-list">

          <li>
            <a href="/">Home</a>
          </li>

          <li>
            <a href="/organizations">
              Organizations
            </a>
          </li>

          <li>
            <a href="/projects">
              Projects
            </a>
          </li>

          <li>
            <a href="/categories">
              Categories
            </a>
          </li>

          <!-- W05: Authentication navigation -->

          <% if (isLoggedIn) { %>

            <li>
              <a href="/dashboard">
                Dashboard
              </a>
            </li>

            <% if (isAdmin) { %>
              <li>
                <a href="/users">
                  Users
                </a>
              </li>
            <% } %>

            <li>
              <form
                action="/logout"
                method="POST"
                class="logout-form"
              >
                <button type="submit">
                  Logout
                </button>
              </form>
            </li>

          <% } else { %>

            <li>
              <a href="/login">
                Login
              </a>
            </li>

            <li>
              <a href="/register">
                Register
              </a>
            </li>

          <% } %>

        </ul>

      </nav>

    </div>

  </header>
