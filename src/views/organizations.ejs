<%- include("partials/header", { title: title }) %>

<main class="page-container">

  <section class="page-heading">

    <p class="eyebrow">
      Our Partners
    </p>

    <h1>
      <%= title %>
    </h1>

    <p>
      Here are a few of our partner organizations.
    </p>

  </section>

  <section class="organization-grid">

    <article class="organization-card">

      <img
        src="/images/brightfuture-logo.png"
        alt="BrightFuture Builders logo"
      >

      <div>
        <h2>BrightFuture Builders</h2>

        <p>
          info@brightfuture.org
        </p>
      </div>

    </article>

    <article class="organization-card">

      <img
        src="/images/greenharvest-logo.png"
        alt="GreenHarvest Growers logo"
      >

      <div>
        <h2>GreenHarvest Growers</h2>

        <p>
          contact@greenharvest.org
        </p>
      </div>

    </article>

    <article class="organization-card">

      <img
        src="/images/unityserve-logo.png"
        alt="UnityServe Volunteers logo"
      >

      <div>
        <h2>UnityServe Volunteers</h2>

        <p>
          hello@unityserve.org
        </p>
      </div>

    </article>

  </section>

</main>

<%- include("partials/footer") %>