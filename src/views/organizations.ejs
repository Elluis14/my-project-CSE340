<%- include("partials/header", { title: title }) %>

<main class="page-container">

  <section class="organizations-section">

    <h1><%= title %></h1>

    <p class="page-intro">
      Here are a few of our partner organizations.
    </p>

    <div class="organizations-grid">

      <% organizations.forEach((organization) => { %>

        <article class="organization-card">

          <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %> logo"
            class="organization-logo"
          >

          <h2>
            <a href="/organization/<%= organization.organization_id %>">
              <%= organization.name %>
            </a>
          </h2>

          <p>
            <%= organization.description %>
          </p>

          <p>
            <strong>Contact:</strong>
            <a href="mailto:<%= organization.contact_email %>">
              <%= organization.contact_email %>
            </a>
          </p>

        </article>

      <% }) %>

    </div>

  </section>

</main>

<%- include("partials/footer") %>