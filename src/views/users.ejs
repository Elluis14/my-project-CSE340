
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <main>
    <h1>Registered Users</h1>

    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(account) { %>
          <tr>
            <td><%= account.name %></td>
            <td><%= account.email %></td>
            <td><%= account.role_name %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <p><a href="/dashboard">Back to Dashboard</a></p>

    <form action="/logout" method="POST">
      <button type="submit">Log Out</button>
    </form>
  </main>
</body>
</html>
