
<%- include("partials/header", { title: title }) %>

<main class="page-container">

  <section class="form-section">

    <h1><%= title %></h1>

    <p class="page-intro">
      Update the information for this organization.
    </p>

    <% if (errors && errors.length > 0) { %>
      <div class="form-errors" role="alert">
        <h2>Please correct the following errors:</h2>

        <ul>
          <% errors.forEach((error) => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form
      action="/edit-organization/<%= organization.organization_id %>"
      method="POST"
      class="organization-form"
    >

      <div class="form-group">
        <label for="name">Organization Name</label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= organization.name %>"
          maxlength="150"
          required
        >
      </div>

      <div class="form-group">
        <label for="description">Description</label>

        <textarea
          id="description"
          name="description"
          rows="5"
          required
        ><%= organization.description %></textarea>
      </div>

      <div class="form-group">
        <label for="contact_email">Contact Email</label>

        <input
          type="email"
          id="contact_email"
          name="contact_email"
          value="<%= organization.contact_email %>"
          maxlength="255"
          required
        >
      </div>

      <div class="form-group">
        <label for="logo_filename">Logo Filename</label>

        <input
          type="text"
          id="logo_filename"
          name="logo_filename"
          value="<%= organization.logo_filename %>"
          maxlength="255"
          required
        >

        <small>
          Enter the filename of an existing image in public/images.
        </small>
      </div>

      <div class="form-actions">

        <button type="submit" class="btn btn-primary">
          Save Changes
        </button>

        <a
          href="/organization/<%= organization.organization_id %>"
          class="btn btn-secondary"
        >
          Cancel
        </a>

      </div>

    </form>

  </section>

</main>

<%- include("partials/footer") %>
