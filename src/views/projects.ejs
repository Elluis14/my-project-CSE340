<%- include("partials/header", { title: title }) %>

<main class="page-container">

  <section class="page-heading">

    <p class="eyebrow">
      Volunteer Opportunities
    </p>

    <h1>
      <%= title %>
    </h1>

    <p>
      Explore upcoming opportunities to serve
      and make a positive impact.
    </p>

  </section>

  <section class="project-grid">

    <article class="project-card">

      <span class="category-label">
        Environmental
      </span>

      <h2>
        Park Cleanup
      </h2>

      <p>
        Join us to clean up local parks and
        make them beautiful.
      </p>

    </article>

    <article class="project-card">

      <span class="category-label">
        Community Service
      </span>

      <h2>
        Food Drive
      </h2>

      <p>
        Help collect and distribute food to
        those in need.
      </p>

    </article>

    <article class="project-card">

      <span class="category-label">
        Educational
      </span>

      <h2>
        Community Tutoring
      </h2>

      <p>
        Volunteer to tutor students in
        various subjects.
      </p>

    </article>

  </section>

</main>

<%- include("partials/footer") %>