
<%- include("partials/header", { title: title }) %>

<main class="page-container">

  <section class="projects-section">

    <h1><%= title %></h1>

    <p class="page-intro">
      Explore upcoming opportunities to serve and make
      a difference in the community.
    </p>

    <p>
      <a href="/new-project" class="btn btn-primary">
        Add New Project
      </a>
    </p>

    <% if (projects.length === 0) { %>

      <p>
        No service projects are currently available.
      </p>

    <% } else { %>

      <div class="projects-grid">

        <% projects.forEach((project) => { %>

          <article class="project-card">

            <h2>
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
            </h2>

            <p>
              <%= project.description %>
            </p>

            <p>
              <strong>Organization:</strong>
              <%= project.organization_name %>
            </p>

            <p>
              <strong>Date:</strong>
              <%= new Date(project.date).toLocaleDateString("en-US", {
                timeZone: "UTC"
              }) %>
            </p>

            <p>
              <strong>Location:</strong>
              <%= project.location %>
            </p>

            <div class="project-actions">

              <a
                href="/project/<%= project.project_id %>"
                class="btn"
              >
                View Details
              </a>

              <a
                href="/edit-project/<%= project.project_id %>"
                class="btn btn-secondary"
              >
                Edit Project
              </a>

            </div>

          </article>

        <% }) %>

      </div>

    <% } %>

  </section>

</main>

<%- include("partials/footer") %>
