
<%- include("partials/header", { title: title }) %>

<main class="page-container">

  <section class="form-section">

    <h1>Edit Service Project</h1>

    <p class="page-intro">
      Update the information for this
      community service project.
    </p>

    <% if (errors && errors.length > 0) { %>

      <div class="error-messages" role="alert">

        <h2>Please correct the following errors:</h2>

        <ul>
          <% errors.forEach((error) => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>

      </div>

    <% } %>

    <form
      action="/edit-project/<%= project.project_id %>"
      method="POST"
      class="data-form"
    >

      <div class="form-group">

        <label for="title">
          Project Title
        </label>

        <input
          type="text"
          id="title"
          name="title"
          value="<%= project.title %>"
          minlength="3"
          maxlength="150"
          required
        >

      </div>

      <div class="form-group">

        <label for="description">
          Project Description
        </label>

        <textarea
          id="description"
          name="description"
          rows="5"
          required
        ><%= project.description %></textarea>

      </div>

      <div class="form-group">

        <label for="location">
          Location
        </label>

        <input
          type="text"
          id="location"
          name="location"
          value="<%= project.location %>"
          maxlength="255"
          required
        >

      </div>

      <div class="form-group">

        <label for="date">
          Project Date
        </label>

        <input
          type="date"
          id="date"
          name="date"
          value="<%= project.date %>"
          required
        >

      </div>

      <div class="form-group">

        <label for="organization_id">
          Organization
        </label>

        <select
          id="organization_id"
          name="organization_id"
          required
        >

          <option value="">
            Select an organization
          </option>

          <% organizations.forEach((organization) => { %>

            <option
              value="<%= organization.organization_id %>"
              <%= String(project.organization_id) ===
                  String(organization.organization_id)
                  ? 'selected'
                  : '' %>
            >
              <%= organization.name %>
            </option>

          <% }) %>

        </select>

      </div>

      <fieldset class="form-group">

        <legend>
          Project Categories
        </legend>

        <p>
          Update the categories associated
          with this project.
        </p>

        <div class="checkbox-group">

          <% categories.forEach((category) => { %>

            <label class="checkbox-label">

              <input
                type="checkbox"
                name="category_ids"
                value="<%= category.category_id %>"
                <%= selectedCategoryIds.includes(
                    String(category.category_id)
                  ) ? 'checked' : '' %>
              >

              <%= category.name %>

            </label>

          <% }) %>

        </div>

      </fieldset>

      <div class="form-actions">

        <button type="submit" class="btn btn-primary">
          Save Changes
        </button>

        <a
          href="/project/<%= project.project_id %>"
          class="btn btn-secondary"
        >
          Cancel
        </a>

      </div>

    </form>

  </section>

</main>

<%- include("partials/footer") %>

