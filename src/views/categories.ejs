<%- include("partials/header", { title: title }) %>

<main class="page-container">

  <section class="page-heading">

    <p class="eyebrow">
      Find Your Cause
    </p>

    <h1>
      <%= title %>
    </h1>

    <p>
      Browse service opportunities based on the
      causes and areas that interest you most.
    </p>

  </section>

  <section class="category-grid">

    <article class="category-card">

      <span class="category-icon">
        🌱
      </span>

      <h2>
        Environmental
      </h2>

      <p>
        Help protect natural spaces, improve local
        environments, and support sustainability.
      </p>

    </article>

    <article class="category-card">

      <span class="category-icon">
        📚
      </span>

      <h2>
        Educational
      </h2>

      <p>
        Support students, educational programs,
        tutoring, and learning opportunities.
      </p>

    </article>

    <article class="category-card">

      <span class="category-icon">
        🤝
      </span>

      <h2>
        Community Service
      </h2>

      <p>
        Strengthen neighborhoods by helping people
        and supporting community initiatives.
      </p>

    </article>

    <article class="category-card">

      <span class="category-icon">
        ❤
      </span>

      <h2>
        Health and Wellness
      </h2>

      <p>
        Participate in projects that support
        physical health and community wellness.
      </p>

    </article>

  </section>

</main>

<%- include("partials/footer") %>